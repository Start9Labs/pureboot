#!/bin/sh
. /etc/functions

echo '*****'
echo '***** WARNING: This will erase all keys and secrets from the TPM'
echo '*****'

read -s -p "New TPM owner password: " key_password
echo

if [ -z "$key_password" ]; then
	die "Empty owner password is not allowed"
fi

read -s -p "Repeat owner password: " key_password2
echo


if [ "$key_password" != "$key_password2" ]; then
	die "Key passwords do not match"
fi

show_exec()
{
	# censor tpm takeown params; includes password
	if [ "$1" == "tpm" ] && [ "$2" == "takeown" ]; then
		warn "$1 $2 <***>"
	else
		warn "$@"
	fi
	"$@"
	local show_exec_result="$?"
	warn "$1 result: $show_exec_result"
	return "$show_exec_result"
}

# Make sure the TPM is ready to be reset
show_exec tpm physicalpresence -s
show_exec tpm physicalenable
show_exec tpm physicalsetdeactivated -c
show_exec tpm forceclear
show_exec tpm physicalenable
show_exec tpm takeown -pwdo "$key_password"

# And now turn it all back on
show_exec tpm physicalpresence -s
show_exec tpm physicalenable
show_exec tpm physicalsetdeactivated -c
